DATABASE_URL="postgresql://kolo_user:kolo_password@localhost:5432/kolo_db?schema=public"
BETTER_AUTH_SECRET="troque-por-um-segredo-com-32-caracteres"
BETTER_AUTH_URL="http://localhost:3000" 
# E-mail de recuperação de senha (Resend). Sem chave, fora de produção o e-mail sai no
# console do servidor; em produção o app não sobe sem ela. No sandbox do Resend, o
# remetente onboarding@resend.dev só entrega para o e-mail dono da conta.
RESEND_API_KEY=""
EMAIL_REMETENTE="Kolô <onboarding@resend.dev>"

# Imagens (Cloudflare R2). Sem estas variáveis o app sobe, mas o envio de imagens falha.
# As chaves vêm de um token de API do R2 com leitura e escrita só no bucket; nunca versione.
# R2_PUBLIC_URL é a URL pública do bucket (pub-xxxx.r2.dev em desenvolvimento, domínio
# próprio em produção) e também libera o host para o next/image (lido na subida do
# next start; num build standalone, precisa existir também no build).
R2_ACCOUNT_ID=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_URL=""

# Opcional: senha inicial do admin@kolo.test, criada pelo seed somente se ainda não há credencial.
# Defina localmente uma senha de 8 a 128 caracteres; não versione o valor.
SEED_ADMIN_PASSWORD=

# Pagamentos (Mercado Pago Checkout Pro). Em sandbox, use o Access Token de "Credenciais de teste"
# da aplicação (passo a passo em docs/features/PBI-27.md); em produção, o da conta real. Sem token,
# o app sobe, mas "Pagar com Mercado Pago" responde com erro. Nunca versione.
MP_ACCESS_TOKEN=""
# URL pública do app usada nas URLs de volta do checkout e no webhook. Com https (domínio ou túnel
# como ngrok/cloudflared), a preferência também pede notificação e retorno automático; em
# http://localhost o Mercado Pago não alcança o app e esses dois campos ficam de fora. Em produção
# o servidor não sobe sem APP_URL em https.
APP_URL="http://localhost:3000"
