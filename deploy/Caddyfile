# Proxy reverso e HTTPS automático (RNF01). O certificado sai do Let's Encrypt para o DOMINIO;
# em DOMINIO=localhost, o Caddy usa a própria autoridade local (simulação na máquina).
# Os cabeçalhos de segurança (CSP, HSTS…) vêm do app (PBI-45); aqui só se tira o Server.
{$DOMINIO} {
	encode zstd gzip
	header -Server
	reverse_proxy app:3000
}

# Endereço anterior (DOMINIO_ANTIGO, ex.: koloatelie.duckdns.org). O navegador vai para o DOMINIO,
# onde o login funciona (BETTER_AUTH_URL). O redirecionamento é temporário (302) para não ficar
# preso no cache do navegador se for preciso voltar ao endereço anterior. O aviso de pagamento de
# um pedido criado antes da troca ainda chega a este endereço e segue direto para o app (RF14).
{$DOMINIO_ANTIGO} {
	header -Server
	handle /api/webhooks/* {
		reverse_proxy app:3000
	}
	handle {
		redir https://{$DOMINIO}{uri} 302
	}
}
