    user {
        uuid id PK
        string papel "CLIENTE, ARTISTA, ADMIN"
        string nome
        string email UK
        string telefone
        string situacao "ATIVO, INATIVO"
        boolean email_verificado
        timestamptz criado_em
        timestamptz excluido_em
    }

    session {
        uuid id PK
        uuid user_id FK
        string token UK
        timestamptz expira_em
        string ip
        string user_agent
    }

    artist {
        uuid id PK
        uuid user_id FK, UK
        string slug UK
    }

    order_item {
        uuid id PK
        uuid order_id FK
        uuid artwork_id FK
        string titulo_copia
        int preco_centavos_copia
        int quantidade
    }

    artwork {
        uuid id PK
        uuid artist_id FK
        string titulo
        string slug UK
        text descricao
        string tecnica
        string dimensoes
        int ano
        int preco_centavos
        int quantidade_estoque
        string situacao "RASCUNHO, DISPONIVEL, ESGOTADA"
        boolean destaque
        timestamptz criado_em
        timestamptz excluido_em
    }

    artwork_reservation {
        uuid id PK
        uuid artwork_id FK
        uuid session_id FK
        int quantidade
        timestamptz expira_em
    }

    order {
        uuid id PK
        string numero UK
        uuid user_id FK
        uuid session_id FK
        string situacao "PENDENTE, PAGO, PROCESSANDO, ENVIADO, ENTREGUE, CANCELADO"
        string modalidade_entrega "RETIRADA, ENTREGA"
        int subtotal_centavos
        int frete_centavos
        int total_centavos
        jsonb endereco_copia
        string codigo_rastreio
        timestamptz criado_em
        timestamptz pago_em
    }

    payment {
        uuid id PK
        uuid order_id FK
        string provedor "MERCADO_PAGO"
        string id_externo "unico junto ao provedor"
        string metodo "PIX, CARTAO, BOLETO, SALDO_MERCADO_PAGO"
        string situacao "PENDENTE, APROVADO, RECUSADO, ESTORNADO"
        int valor_centavos
        string estornar_motivo "PEDIDO_NAO_PENDENTE, VALOR_DIVERGENTE, SEM_ESTOQUE"
    }

    appointment {
        uuid id PK
        string codigo UK
        uuid artist_id FK
        uuid user_id FK
        string nome_contato
        string telefone_contato
        string situacao "AGENDADO, CANCELADO, CONCLUIDO"
        timestamptz inicia_em
        timestamptz termina_em
        string regiao_corpo
        text descricao
    }
