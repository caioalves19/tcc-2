# Modelo do .env.production da VPS (PBI-46). Copie para .env.production NA VPS, preencha e
# nunca versione (RNF12). O arquivo de verdade só existe no servidor.
#   cp .env.production.example .env.production && chmod 600 .env.production
# Gerar segredos: openssl rand -hex 32

# --- Endereço público -------------------------------------------------------------------------
# Domínio que aponta para o IP da VPS (DuckDNS hoje; troca descrita em docs/DEPLOY.md).
DOMINIO="koloatelie.duckdns.org"

# --- Banco -----------------------------------------------------------------------------------
# Só letras e números (entra na URL de conexão). Ex.: openssl rand -hex 24
POSTGRES_PASSWORD=""

# --- Autenticação ----------------------------------------------------------------------------
# 32+ caracteres aleatórios. Trocar invalida todas as sessões.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="https://koloatelie.duckdns.org"
# Senha do admin@kolo.test criada pelo `npm run db:seed` (8 a 128 caracteres).
SEED_ADMIN_PASSWORD=""

# --- URL pública e Mercado Pago (sandbox) ----------------------------------------------------
# Tem de ser https: o app não sobe em produção sem isso.
APP_URL="https://koloatelie.duckdns.org"
# Credenciais de TESTE da aplicação no painel do Mercado Pago.
MP_ACCESS_TOKEN=""
# Assinatura secreta do webhook (mesma tela onde se cadastra
# https://<DOMINIO>/api/webhooks/mercadopago com o evento "Pagamentos").
MP_WEBHOOK_SECRET=""

# --- E-mail (recuperação de senha) -----------------------------------------------------------
# Obrigatória em produção. Sem domínio verificado no Resend, só entrega ao dono da conta.
RESEND_API_KEY=""
EMAIL_REMETENTE="Kolô <onboarding@resend.dev>"

# --- Imagens: bucket de PRODUÇÃO kolo-imagens ------------------------------------------------
# Token restrito ao kolo-imagens. CORS do bucket liberando https://<DOMINIO>.
R2_ACCOUNT_ID=""
R2_BUCKET="kolo-imagens"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Também vai para o build da imagem (next/image); depois de mudar, rode o deploy de novo.
R2_PUBLIC_URL=""

# --- Backup: bucket kolo-backups -------------------------------------------------------------
# Token "kolo-backups-vps" (Object Read & Write só nesse bucket). Vazio = backup só na VPS.
R2_BACKUP_BUCKET="kolo-backups"
R2_BACKUP_ACCESS_KEY_ID=""
R2_BACKUP_SECRET_ACCESS_KEY=""
# Horário diário do backup, fuso de São Paulo.
HORA_BACKUP="03:00"

# --- Formulário de contato (Cloudflare Turnstile) --------------------------------------------
# Vazias = chaves de teste da Cloudflare (o desafio sempre passa). A chave do site vai embutida
# no navegador no build: depois de mudar, rode o deploy de novo.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
